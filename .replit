modules = ["nodejs-22", "web", "python-base-3.13"]

[nix]
channel = "stable-25_05"
packages = ["glib", "gtk3", "nss", "nspr", "atk", "at-spi2-atk", "cups", "libdrm", "mesa", "pango", "cairo", "alsa-lib", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb"]

[agent]
expertMode = true

[userenv]

[userenv.shared]
SUPABASE_URL = "https://pfzjbazocmgflcogjjrg.supabase.co"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 24678
externalPort = 80
