# Required server-side AI configuration. Never expose this key to Vite/browser code.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EVALUATION_MODEL=gemini-3.6-flash

# Experimental only. The production audit intelligence path is Gemini HTTP.
ENABLE_GEMINI_LIVE=false
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Required server-side Supabase configuration. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy/experimental CareerVoice Pipecat Voice Service configuration.
# Production browser voice uses the in-app OpenRouter STT/LLM/TTS path below.
PIPECAT_SERVICE_URL=https://7pmmmiwq7m.ap-south-1.awsapprunner.com
PIPECAT_SERVICE_TOKEN=

# Required server-side OpenRouter configuration for production Qalam voice.
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=openrouter/auto,deepseek/deepseek-chat
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro
OPENROUTER_STT_MODEL=openai/gpt-4o-mini-transcribe

# Deprecated alias supported for backward compatibility.
CAREERVOICE_SERVICE_TOKEN=

# Optional OpenRouter AI Configuration for LLM, TTS, STT with multi-tier fallback
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro
OPENROUTER_TTS_VOICE=
OPENROUTER_STT_MODEL=openai/whisper-large-v3

# Optional deployment URL used for callbacks/self-referential links where required.
APP_URL=
