# Required server-side AI configuration. Never expose this key to Vite/browser code.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EVALUATION_MODEL=gemini-3.6-flash

# Experimental only. The production audit intelligence path is Gemini HTTP.
ENABLE_GEMINI_LIVE=false
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Required server-side Supabase configuration. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional deployment URL used for callbacks/self-referential links where required.
APP_URL=
