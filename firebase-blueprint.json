{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User identity and student profile information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "phone": { "type": "string", "maxLength": 30 },
        "countryCode": { "type": "string", "maxLength": 10 },
        "isOtpVerified": { "type": "boolean" },
        "anonymousId": { "type": "string", "maxLength": 100 },
        "sessionId": { "type": "string", "maxLength": 100 },
        "referralCode": { "type": "string", "maxLength": 50 },
        "campaignId": { "type": "string", "maxLength": 50 },
        "collegeId": { "type": "string", "maxLength": 100 },
        "degree": { "type": "string", "maxLength": 100 },
        "year": { "type": "string", "maxLength": 50 },
        "collegeName": { "type": "string", "maxLength": 200 },
        "branch": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "anonymousId", "sessionId", "createdAt"]
    },
    "AuditSession": {
      "title": "Audit Session",
      "description": "Career audit results and evaluation details",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "anonymousId": { "type": "string", "maxLength": 100 },
        "sessionId": { "type": "string", "maxLength": 100 },
        "targetRole": { "type": "string", "maxLength": 100 },
        "overallScore": { "type": "number" },
        "diagnosisSummary": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "anonymousId", "sessionId", "targetRole", "overallScore", "createdAt"]
    },
    "AnalyticsEvent": {
      "title": "Analytics Event",
      "description": "Streamed analytics event for user session and conversion funnel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventName": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string" },
        "anonymousId": { "type": "string", "maxLength": 100 },
        "sessionId": { "type": "string", "maxLength": 100 },
        "auditId": { "type": "string", "maxLength": 100 },
        "screenName": { "type": "string", "maxLength": 100 },
        "careerRole": { "type": "string", "maxLength": 100 },
        "collegeId": { "type": "string", "maxLength": 100 },
        "campaignId": { "type": "string", "maxLength": 50 },
        "referralCode": { "type": "string", "maxLength": 50 },
        "inputMethod": { "type": "string", "maxLength": 20 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "eventName", "anonymousId", "sessionId", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user profiles"
    },
    "/auditSessions/{sessionId}": {
      "schema": { "$ref": "#/entities/AuditSession" },
      "description": "Stores career audit sessions"
    },
    "/analyticsEvents/{eventId}": {
      "schema": { "$ref": "#/entities/AnalyticsEvent" },
      "description": "Stores tracking events"
    }
  }
}
